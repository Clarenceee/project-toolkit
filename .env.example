# Only enable remote execution when your project has configured its infrastructure.
METAFLOW_RUN_K8=false
METAFLOW_KUBERNETES_IMAGE=
METAFLOW_KUBERNETES_NAMESPACE=
METAFLOW_KUBERNETES_SERVICE_ACCOUNT=
METAFLOW_KUBERNETES_CPU=1
METAFLOW_KUBERNETES_MEMORY=256
METAFLOW_KUBERNETES_GPU=0
METAFLOW_KUBERNETES_IMAGE_PULL_SECRETS=[]
METAFLOW_KUBERNETES_SECRETS=[]
METAFLOW_KUBERNETES_TOLERATIONS=[]
METAFLOW_STEP_ENV_VARS={}
# Configure Metaflow's datastore/metadata variables in the consuming project.

AIRFLOW_POD_IMAGE=
AIRFLOW_POD_NAMESPACE=
AIRFLOW_POD_SERVICE_ACCOUNT=
AIRFLOW_POD_IMAGE_PULL_SECRETS=[]
AIRFLOW_POD_ENV_VARS={}

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
ALEMBIC_CONFIG=alembic.ini
ALEMBIC_REVISION=head

LOG_LEVEL=INFO

# Optional drift configuration; the example supplies feature types directly.
# DRIFT_FEATURE_TYPES={"value":"numerical","category":"categorical"}
DRIFT_MAX_NUMERICAL_BINS=8
DRIFT_PSI_WARNING_THRESHOLD=0.10
DRIFT_PSI_DRIFT_THRESHOLD=0.25
DRIFT_PSI_ZERO_PROPORTION_EPSILON=1e-10
DRIFT_SHAP_TOP_K=10
